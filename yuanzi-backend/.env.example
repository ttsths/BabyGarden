# BabyGarden 部署环境变量
# 复制为 .env 文件填入真实值（不可提交到 GitHub）
#
# 使用方式（Cloudflare Containers 部署时通过 wrangler 或 dashboard 设置）:
#   wrangler secret put GROKAI_API_KEY
#   或在 Cloudflare Dashboard → Workers & Pages → Settings → Variables

# === GrokAI (首选) ===
GROKAI_ENABLED=true
GROKAI_BASE_URL=
GROKAI_API_KEY=
GROKAI_MODEL=grok-4.1-fast

# === Cloudflare Workers AI (第二优先级) ===
CLOUDFLARE_AI_ENABLED=true
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_AI_GATEWAY_ID=yuanzi-ai-gateway
CLOUDFLARE_AI_USE_GATEWAY=true
CLOUDFLARE_AI_MODEL=@cf/moonshotai/kimi-k2.6

# === DashScope (第三优先级) ===
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus

# === CLIProxyAPI (最后 fallback) ===
CLIPROXY_ENABLED=false
CLIPROXY_BASE_URL=
CLIPROXY_API_KEY=
CLIPROXY_MODEL=gpt-5.5
