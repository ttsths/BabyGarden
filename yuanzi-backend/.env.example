# BabyGarden 部署环境变量
# 复制为 .env 文件填入真实值（不可提交到 GitHub）
#
# 使用方式（Cloudflare Containers 部署时通过 wrangler 或 dashboard 设置）:
#   wrangler secret put DATABASE_PASSWORD
#   或在 Cloudflare Dashboard → Workers & Pages → Settings → Variables
#
# Viper AutomaticEnv() 会自动映射：DATABASE_PASSWORD → database.password
# 环境变量名规则：用 _ 替换配置中的 .（如 r2.account_id → R2_ACCOUNT_ID）

# === Server ===
SERVER_RUN_MODE=debug
SERVER_HTTP_PORT=8080

# === Database ===
DATABASE_TYPE=mysql
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=yuanzi

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=1

# === JWT ===
JWT_SECRET=
JWT_EXPIRE_DURATION=2h
JWT_REFRESH_DAYS=7

# === OSS (阿里云) ===
OSS_REGION=cn-hangzhou
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_CDN_DOMAIN=
OSS_CALLBACK_SECRET=

# === R2 (Cloudflare) ===
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_ACCESS_KEY_SECRET=
R2_BUCKET=
R2_PUBLIC_URL=

# === Storage ===
STORAGE_PROVIDER=r2

# === SMS (阿里云) ===
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# === AI Provider Chain ===
AI_PROVIDER_CHAIN=grokai,cloudflare_workers_ai,dashscope,cliproxyapi
AI_TIMEOUT_SECONDS=45
AI_ENABLE_FALLBACK=true

# === AI Safety ===
AI_SAFETY_MAX_PROMPT_CHARS=12000
AI_SAFETY_MAX_OUTPUT_TOKENS=1200

# === AI Quota ===
AI_QUOTA_PER_USER_DAILY_LIMIT=50
AI_QUOTA_PER_FAMILY_DAILY_LIMIT=200

# === GrokAI (首选) ===
AI_GROKAI_ENABLED=true
AI_GROKAI_BASE_URL=
AI_GROKAI_API_KEY=
AI_GROKAI_MODEL=grok-4.1-fast
AI_GROKAI_TIMEOUT_SECONDS=45

# === Cloudflare Workers AI (第二优先级) ===
AI_CLOUDFLARE_ENABLED=true
AI_CLOUDFLARE_ACCOUNT_ID=
AI_CLOUDFLARE_API_TOKEN=
AI_CLOUDFLARE_GATEWAY_ID=yuanzi-ai-gateway
AI_CLOUDFLARE_USE_GATEWAY=true
AI_CLOUDFLARE_MODEL=@cf/moonshotai/kimi-k2.6
AI_CLOUDFLARE_DAILY_NEURON_BUDGET=9000
AI_CLOUDFLARE_HARD_NEURON_BUDGET=9800
AI_CLOUDFLARE_TIMEOUT_SECONDS=45
AI_CLOUDFLARE_CACHE_TTL_SECONDS=300

# === DashScope (第三优先级) ===
AI_DASHSCOPE_ENABLED=true
AI_DASHSCOPE_API_KEY=
AI_DASHSCOPE_MODEL=qwen-plus
AI_DASHSCOPE_TIMEOUT_SECONDS=45

# === CLIProxyAPI (最后 fallback) ===
AI_CLIPROXYAPI_ENABLED=false
AI_CLIPROXYAPI_BASE_URL=
AI_CLIPROXYAPI_API_KEY=
AI_CLIPROXYAPI_MODEL=gpt-5.5
AI_CLIPROXYAPI_TIMEOUT_SECONDS=60

# === NLS (阿里云语音识别，旧字段兼容) ===
AI_DASHSCOPE_API_KEY_COMPAT=
AI_NLS_APP_KEY=
AI_NLS_ENDPOINT=
AI_NLS_ACCESS_KEY_ID=
AI_NLS_ACCESS_KEY_SECRET=

# === Push (APNs) ===
PUSH_APNS_TEAM_ID=
PUSH_APNS_KEY_ID=
PUSH_APNS_BUNDLE_ID=
PUSH_APNS_KEY_PATH=
PUSH_APNS_USE_SANDBOX=true
PUSH_APNS_TIMEOUT_SECONDS=10